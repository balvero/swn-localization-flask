# Copy this file to .env and fill in real values.

# Same Supabase Postgres connection string the existing app uses (the
# NETLIFY_DATABASE_URL_PROD value from netlify-localization/.env.production).
DATABASE_URL=

# Optional: a second connection string, only used if USE_PROD_DB=true below.
DATABASE_URL_PROD=

# Set to "true" to point this server at DATABASE_URL_PROD instead of
# DATABASE_URL. Leave unset/false normally — DATABASE_URL is the only
# connection string most setups need.
USE_PROD_DB=false

# Ordinary Gemini API key — no special naming needed here. The
# GEMINI_API_KEY_DIRECT workaround in the original app existed only because
# Netlify's own CLI/runtime auto-detects "GEMINI_API_KEY" and silently
# reroutes it through Netlify's AI Gateway; that doesn't apply to this
# project at all since it isn't hosted on Netlify.
GEMINI_API_KEY=

# AI drafting backend: "gemini" (default), "ollama", or "openrouter".
# Ollama is local-only (no daily request quota, but needs `ollama serve`
# running with the model pulled — see README) — never set this to "ollama"
# on anything deployed, since Ollama won't be reachable there. OpenRouter
# is cloud-hosted (works anywhere, including deployed) but its free tier
# has its own rate limit — see OPENROUTER_MODEL below.
DRAFT_BACKEND=gemini

# Only used when DRAFT_BACKEND=ollama. Deliberately a general
# instruction-following model (Gemma 4), not Gemma's translation-specialized
# sibling TranslateGemma — that one's fixed single-string prompt format
# can't carry this app's glossary/style-guide/batch context. e2b ("edge"),
# not a bigger size — measured directly: gemma4:12b took 7+ minutes on a
# glossary-constrained prompt and never finished; e2b did the same prompt
# correctly in ~33s. The "edge" tier is built for on-device speed and
# handled this app's short marketing-copy strings just fine.
OLLAMA_MODEL=gemma4:e2b

# Only used when DRAFT_BACKEND=openrouter. Get a key at
# https://openrouter.ai/settings/keys (free to create; the model below
# doesn't consume paid credits).
OPENROUTER_API_KEY=

# Free-tier Gemma 4 31B (full dense model, cloud-hosted — not bottlenecked
# by local hardware the way gemma4:12b was over Ollama). The free variant
# has its own per-minute/per-day rate limit; exact numbers aren't published
# in a way that's checkable outside the OpenRouter dashboard, so if drafting
# starts failing with 429s under heavy use, that's why.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# "development" (default) or "production". Currently only gates the
# translation-key DELETE endpoint (see app/routes/translation_keys.py).
APP_ENV=development

# Auth mode. Only "mock" exists so far — treats every request as a fixed
# local user, mirroring the old app's LOCAL_DEV bypass. Real auth
# (Supabase Auth is the leading candidate) is a deliberately separate,
# later step — see app/auth.py.
AUTH_MODE=mock

# Restrict CORS to your real frontend origin once you have one deployed.
# Leave unset ("*") for local development.
CORS_ORIGIN=
